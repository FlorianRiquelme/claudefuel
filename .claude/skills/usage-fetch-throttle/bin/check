#!/bin/bash
# Model-check the usage-fetch gate of statusline.sh and compare each rule's
# result with model/expected. See ../SKILL.md.
#
#   bin/check                 concurrent + sequential configs (~30 s)
#   bin/check --deep          also the 3-run config (~2 min)
#   bin/check CONFIG RULE     one run, full counterexample trace
#
# Exit 0: every result matches model/expected. Exit 1: a mismatch.
# Exit 2: the tools could not be set up.
set -u

SKILL_DIR=$(cd "$(dirname "$0")/.." && pwd)
MODEL_DIR="$SKILL_DIR/model"
REPO_ROOT=$(cd "$SKILL_DIR/../../.." && pwd)
TLC_VERSION=1.7.4
TLC_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
TOOL_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claudefuel-tla"

die() { echo "check: $*" >&2; exit 2; }

find_java() {
    local j
    for j in "${JAVA:-}" "$(command -v java 2>/dev/null)" \
             /opt/homebrew/opt/openjdk/bin/java /usr/local/opt/openjdk/bin/java; do
        [ -n "$j" ] && [ -x "$j" ] && "$j" -version >/dev/null 2>&1 && { echo "$j"; return 0; }
    done
    return 1
}

find_jar() {
    local jar="$TOOL_DIR/tla2tools-$TLC_VERSION.jar" sum
    if [ -n "${TLA2TOOLS:-}" ]; then echo "$TLA2TOOLS"; return 0; fi
    if [ ! -f "$jar" ]; then
        mkdir -p "$TOOL_DIR" || return 1
        curl -fsSL -o "$jar.part" \
            "https://github.com/tlaplus/tlaplus/releases/download/v$TLC_VERSION/tla2tools.jar" || return 1
        mv "$jar.part" "$jar"
    fi
    sum=$(shasum -a 256 "$jar" | cut -d' ' -f1)
    [ "$sum" = "$TLC_SHA256" ] || { rm -f "$jar"; echo "check: tla2tools.jar checksum mismatch" >&2; return 1; }
    echo "$jar"
}

JAVA_BIN=$(find_java) || die "no working Java 11+. Install one: brew install openjdk (macOS) or apt install default-jre (Linux), or set JAVA=/path/to/java."
JAR=$(find_jar) || die "could not fetch tla2tools.jar v$TLC_VERSION (needs network once), or set TLA2TOOLS=/path/to/tla2tools.jar."

OUT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/usage-fetch-throttle.XXXXXX")

# --- Sync: has the code the model describes changed since it was confirmed?
covered_region() {
    sed -n '/^claudefuel_try_lock() {/,/^# Fall back to stale cache whenever/p' "$REPO_ROOT/statusline.sh"
}
sync_check() {
    local recorded_commit recorded_sum sum
    recorded_commit=$(sed -n 's/^sync-commit: *//p' "$SKILL_DIR/SKILL.md" | head -n1)
    recorded_sum=$(sed -n 's/^covered-sha256: *//p' "$SKILL_DIR/SKILL.md" | head -n1)
    sum=$(covered_region | shasum -a 256 | cut -d' ' -f1)
    if [ -z "$(covered_region)" ]; then
        echo "SYNC  covered region not found in statusline.sh (markers moved?) — re-read the model against the code"
    elif [ "$sum" = "$recorded_sum" ]; then
        echo "SYNC  covered code unchanged since $recorded_commit"
    else
        echo "SYNC  covered code CHANGED since $recorded_commit (sha256 $sum)"
        echo "      Mirror the change in model/UsageFetch.tla before trusting these results."
        echo "      See: git diff $recorded_commit -- statusline.sh"
    fi
}

# --- One TLC run: config + single rule. Prints "holds", "violated", or "error".
run_rule() {
    local cfg="$1" rule="$2" out="$OUT_DIR/$1-$2"
    { grep -v '^INVARIANT' "$MODEL_DIR/$cfg.cfg"; echo "INVARIANT $rule"; } > "$out.cfg"
    (cd "$MODEL_DIR" && "$JAVA_BIN" -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
        -workers auto -metadir "$out.states" \
        UsageFetch.tla -config "$out.cfg") > "$out.out" 2>&1
    rm -rf "$out.states"
    if grep -q "Invariant $rule is violated" "$out.out"; then echo violated
    elif grep -q "No error has been found" "$out.out"; then echo holds
    else echo error
    fi
}

show_trace() {
    awk '/is violated/{f=1} f' "$1" | "$SKILL_DIR/bin/trace"
}

if [ $# -eq 2 ]; then
    sync_check
    result=$(run_rule "$1" "$2")
    echo "$1 $2: $result"
    case "$result" in
        violated) show_trace "$OUT_DIR/$1-$2.out" ;;
        error) tail -n 30 "$OUT_DIR/$1-$2.out" ;;
    esac
    echo "TLC output: $OUT_DIR/$1-$2.out"
    exit 0
fi

configs="concurrent sequential"
[ "${1:-}" = "--deep" ] && configs="concurrent sequential deep"

sync_check
status=0
while read -r cfg rule want finding; do
    case "$cfg" in ''|'#'*) continue ;; esac
    case " $configs " in *" $cfg "*) ;; *) continue ;; esac
    got=$(run_rule "$cfg" "$rule")
    if [ "$got" = "$want" ]; then
        if [ "$got" = violated ]; then
            printf 'ok    %-11s %-15s violated  (known finding %s)\n' "$cfg" "$rule" "$finding"
        else
            printf 'ok    %-11s %-15s holds\n' "$cfg" "$rule"
        fi
    else
        status=1
        printf 'FAIL  %-11s %-15s expected %s, got %s\n' "$cfg" "$rule" "$want" "$got"
        case "$got" in
            violated) show_trace "$OUT_DIR/$cfg-$rule.out" | sed 's/^/      /' ;;
            error) tail -n 20 "$OUT_DIR/$cfg-$rule.out" | sed 's/^/      /' ;;
            holds) echo "      Finding $finding no longer reproduces. If the code fixed it, update model/expected and SKILL.md." ;;
        esac
    fi
done < "$MODEL_DIR/expected"

echo "TLC output: $OUT_DIR"
exit $status
